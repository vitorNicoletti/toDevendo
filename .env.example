# Porta exposta do WAHA (gateway do WhatsApp)
WAHA_PORT=3000

# Credenciais do banco MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# Chave da API do WAHA (defina um valor forte e secreto)
WAHA_API_KEY=

# ID do grupo do WhatsApp autorizado a usar o bot (formato: 1234567890@g.us)
ALLOWED_GROUP_IDS=

# Nome do bot (usado como prefixo das mensagens, ex: [NicoBot])
BOT_NAME=NicoBot
